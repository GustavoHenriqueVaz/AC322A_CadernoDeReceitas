<?xml version="1.0" encoding="utf-8"?>
<!-- Seguranca: o app so conversa por HTTPS. Trafego em texto puro (http://) e bloqueado. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
